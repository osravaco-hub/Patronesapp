# ===================================
# GeoPattern - Variables de Entorno
# ===================================
# Copia este archivo a .env.local y completa los valores

# ===================================
# AUTENTICACIÓN (NextAuth)
# ===================================
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# URL de la aplicación (cambiar en producción)
NEXTAUTH_URL=http://localhost:5173

# ===================================
# GOOGLE OAUTH
# ===================================
# Obtener de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================================
# STRIPE (Pagos)
# ===================================
# Obtener de: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# IDs de precios (crear en Stripe Dashboard)
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# Clave pública (para frontend)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# ===================================
# SUPABASE (Base de datos)
# ===================================
# Obtener de: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===================================
# RESEND (Emails transaccionales)
# ===================================
# Obtener de: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# ===================================
# ANALYTICS (Plausible o Umami)
# ===================================
# Plausible (self-hosted)
NEXT_PUBLIC_PLAUSIBLE_URL=https://plausible.yourdomain.com

# O Umami (self-hosted)
NEXT_PUBLIC_UMAMI_URL=https://umami.yourdomain.com/script.js
NEXT_PUBLIC_UMAMI_ID=your-umami-website-id

# ===================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===================================
# Entorno (development, production)
NODE_ENV=development

# URL del sitio (para SEO y emails)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# ===================================
# OPCIONAL
# ===================================
# Para debugging
DEBUG=false

# Rate limiting (requests por minuto)
RATE_LIMIT_MAX=100
